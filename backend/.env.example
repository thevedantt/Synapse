# Neon connection string (Dashboard > Connect). Keep ?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Amazon Bedrock API key (Bedrock console > API keys > long-term key)
AWS_BEARER_TOKEN_BEDROCK=
# Free plan is locked to Sydney
AWS_REGION=ap-southeast-2

# Orchestrator: plans, picks tools, writes SQL and the final answer.
# Alternative: openai.gpt-oss-120b-1:0
ORCHESTRATOR_MODEL=deepseek.v3.2

# Created automatically by seed.py (password for the agent's restricted DB logins)
AGENT_DB_PASSWORD=

# Created automatically by setup_guardrail.py
GUARDRAIL_ID=
GUARDRAIL_VERSION=

# Neon Auth URL (Neon console > Auth). Backend verifies login tokens with it.
NEON_AUTH_BASE_URL=
# DEV ONLY: allow fake demo accounts without email verification. Never true in production.
ALLOW_UNVERIFIED_EMAILS=false
