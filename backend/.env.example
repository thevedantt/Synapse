# Neon connection string (Dashboard > Connect). Keep ?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Amazon Bedrock API key (Bedrock console > API keys)
AWS_BEARER_TOKEN_BEDROCK=
# Free plan is locked to Sydney
AWS_REGION=ap-southeast-2

# Model. Opus = best quality. Cheaper for dev/testing:
#   anthropic.claude-sonnet-5-5  (~half the cost of Opus)
#   anthropic.claude-haiku-5-5   (~40x cheaper than Opus)
BEDROCK_MODEL=anthropic.claude-opus-5-5
